# =============================================================================
# GPS Field Assist - Variables d'environnement Docker Compose
# =============================================================================

# Base de données
POSTGRES_DB=tunav_gps_tracking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend
BACKEND_PORT=8001
BACKEND_HOST=0.0.0.0
SECRET_KEY=tunav_gps_secret_key_dev_2024

# Jenkins (optionnel)
JENKINS_OPTS="--prefix=/jenkins"

# Monitoring
LOG_LEVEL=INFO
ENABLE_METRICS=true

# =============================================================================
# Note: Pour la production, changez les valeurs suivantes:
# - POSTGRES_PASSWORD: utilisez un mot de passe fort
# - SECRET_KEY: générez une clé JWT sécurisée (64 caractères aléatoires)
# =============================================================================
