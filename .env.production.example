# =============================================================================
# GPS Field Assist - Configuration Production
# =============================================================================

# Base de données (production)
POSTGRES_DB=tunav_gps_tracking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGER_AVEC_MOT_DE_PASSE_FORT_32_CHARS

# Backend
BACKEND_PORT=8001
BACKEND_HOST=0.0.0.0
SECRET_KEY=CHANGER_AVEC_CLE_JWT_64_CHARS_ALEATOIRES

# Jenkins
JENKINS_OPTS="--prefix=/jenkins"

# Monitoring
LOG_LEVEL=WARNING
ENABLE_METRICS=true

# Email (alertes)
ALERT_EMAIL=devops@tunav-it.com
SMTP_HOST=smtp.tunav-it.com
SMTP_PORT=587

# Slack (alertes)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Backup
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=  # Optionnel: AWS S3 pour backup externe

# =============================================================================
# IMPORTANT:
# 1. Générez une clé SECRET_KEY: openssl rand -base64 64
# 2. Utilisez un mot de passe PostgreSQL fort (min 32 caractères)
# 3. Configurez les alertes (email/Slack) pour la production
# 4. Stockez ce fichier dans un gestionnaire de secrets (Vault/AWS Secrets)
# =============================================================================
