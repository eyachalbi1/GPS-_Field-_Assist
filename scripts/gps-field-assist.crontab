# =============================================================================
# GPS Field Assist - Configuration Cron
# Sauvegardes automatiques et monitoring
# =============================================================================

# ── Sauvegarde PostgreSQL toutes les 24h à 2h du matin ────────────────────────
# Exécute le script de backup avec le conteneur postgres
0 2 * * * docker exec gps_postgres pg_dump -U postgres tunav_gps_tracking_db | gzip > /var/backups/gps-field-assist/backup_$(date +\%Y\%m\%d_\%H\%M\%S).sql.gz && find /var/backups/gps-field-assist -name "backup_*.sql.gz" -type f -mtime +7 -delete

# Alternative: utiliser le script de backup complet
# 0 2 * * * /usr/local/bin/backup_postgres.sh

# ── Monitoring des services toutes les 5 minutes ─────────────────────────────
*/5 * * * * /usr/local/bin/monitor_services.sh

# ── Nettoyage des logs Docker (anciennes images, conteneurs arrêtés) ──────────
# Tous les dimanches à 3h
0 3 * * 0 docker system prune -f --filter "until=168h" || true

# ── Vérification de l'espace disque (alerte si >85%) ──────────────────────────
# Tous les jours à 6h
0 6 * * * /usr/local/bin/check_disk_space.sh || true

# =============================================================================
# Instructions d'installation:
# 1. Copier ce fichier dans /etc/cron.d/gps-field-assist
#    sudo cp gps-field-assist.crontab /etc/cron.d/gps-field-assist
# 2. Rendre exécutable les scripts:
#    chmod +x /usr/local/bin/backup_postgres.sh
#    chmod +x /usr/local/bin/monitor_services.sh
# 3. Redémarrer cron:
#    sudo systemctl restart cron
# =============================================================================
