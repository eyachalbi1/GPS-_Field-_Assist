# ⚙️ Configuration de la base de données PostgreSQL
# IMPORTANT: Copiez ce fichier en .env et modifiez les valeurs

DB_HOST=localhost
DB_NAME=tunav_gps_tracking_db
DB_USER=postgres

# ⚠️ MODIFIEZ CETTE LIGNE avec votre mot de passe PostgreSQL
# Pour trouver votre mot de passe:
# 1. Celui que vous avez défini lors de l'installation de PostgreSQL
# 2. Testez avec: psql -U postgres (il demandera le mot de passe)
DB_PASSWORD=votre_mot_de_passe_postgres

DB_PORT=5432

# Configuration JWT (ne pas modifier)
SECRET_KEY=tunav_gps_secret_key_2024

# Configuration serveur (ne pas modifier)
PORT=8000
HOST=0.0.0.0

# 📝 Instructions:
# 1. Renommez ce fichier en .env (sans .example)
# 2. Modifiez DB_PASSWORD avec votre vrai mot de passe PostgreSQL
# 3. Lancez: python setup_db.py
# 4. Lancez: python create_test_user.py
# 5. Démarrez le serveur: python -m uvicorn main:app --reload --port 8000
