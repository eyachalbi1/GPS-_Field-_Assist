# ============================================
# GPS Field Assist — Configuration Backend
# Copiez ce fichier en .env et adaptez les valeurs
# ============================================

# --- Base de données PostgreSQL ---
# En local (sans Docker) : localhost:5432
# En Docker (docker-compose) : db (nom du service)
DB_HOST=db
DB_NAME=tunav_gps_tracking_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# --- Sécurité JWT ---
SECRET_KEY=tunav_gps_secret_key_2024

# --- Serveur ---
PORT=8000
HOST=0.0.0.0
